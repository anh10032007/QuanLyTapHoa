@model QuanLyTapHoa.Models.Account

@{
    ViewBag.Title = "Đăng nhập hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success bg-gradient text-white text-center py-4 rounded-top-4">
                    <h3 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập</h3>
                    <small class="opacity-75">Chào mừng bạn quay trở lại!</small>
                </div>

                <div class="card-body p-5">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Thất bại!</strong><br />
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Login", "User", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Tài khoản / Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-circle text-success fs-5"></i></span>
                                <input type="text" class="form-control bg-light border-start-0 py-2" id="TenDangNhap" name="USERNAME"
                                       value="@ViewBag.Email"
                                       placeholder="Nhập tên đăng nhập..." required autofocus>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key-fill text-success fs-5"></i></span>
                                <input type="password" class="form-control bg-light border-start-0 py-2" id="MatKhau" name="PASSWORD"
                                       placeholder="Nhập mật khẩu..." required>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input border-success" id="rememberMe">
                                <label class="form-check-label text-secondary small" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>
                            <a href="#" class="text-decoration-none small text-success fw-bold hover-underline">Quên mật khẩu?</a>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow fw-bold text-uppercase py-3" style="letter-spacing: 1px;">
                                Đăng Nhập Hệ Thống
                            </button>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white text-center py-4 rounded-bottom-4 border-top-0">
                    <p class="text-muted small mb-2">Bạn chưa có tài khoản thành viên?</p>
                    <a href="@Url.Action("Register", "User")" class="btn btn-outline-success fw-bold rounded-pill px-4">
                        <i class="bi bi-person-plus-fill me-1"></i> Đăng ký ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hiệu ứng focus cho input đẹp hơn */
    .form-control:focus {
        box-shadow: none;
        border-color: #198754;
        background-color: #fff;
    }

    .input-group-text {
        border-color: #ced4da;
    }
    /* Khi focus vào input thì đổi màu icon bên cạnh */
    .form-control:focus + .input-group-text,
    .input-group:focus-within .input-group-text {
        border-color: #198754;
        background-color: #e9f7ef;
    }

    .hover-underline:hover {
        text-decoration: underline !important;
    }
</style>