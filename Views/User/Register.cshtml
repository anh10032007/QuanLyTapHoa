@model QuanLyTapHoa.tblKhachHang

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h3 class="fw-bold mb-0">Đăng Ký Thành Viên</h3>
            </div>
            <div class="card-body p-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @Html.Raw(ViewBag.Error)
                    </div>
                }

                @using (Html.BeginForm("Register", "User", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập (*)</label>
                        <input type="text" class="form-control" name="TenDangNhap"
                               value="@(Model != null ? Model.TenDangNhap : "")" required placeholder="Ví dụ: khachhang1">
                        <div class="form-text">Dùng để đăng nhập vào hệ thống.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên (*)</label>
                        <input type="text" class="form-control" name="TenKH"
                               value="@(Model != null ? Model.TenKH : "")" required placeholder="Nguyễn Văn A">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email (*)</label>
                        <input type="email" class="form-control" name="Email"
                               value="@(Model != null ? Model.Email : "")" required placeholder="abc@gmail.com">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Mật khẩu (*)</label>
                            <input type="password" class="form-control" name="MatKhau" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Xác nhận mật khẩu (*)</label>
                            <input type="password" class="form-control" name="MatKhauXacNhan" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="text" class="form-control" name="SDT"
                               value="@(Model != null ? Model.SDT : "")" placeholder="09xxxxxxxxx">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ nhận hàng</label>
                        <textarea class="form-control" name="DiaChi" rows="2">@(Model != null ? Model.DiaChi : "")</textarea>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success fw-bold">
                            <i class="bi bi-person-plus-fill"></i> ĐĂNG KÝ NGAY
                        </button>
                    </div>
                }
            </div>
            <div class="card-footer text-center py-3">
                <small>Đã có tài khoản? <a href="@Url.Action("Login", "User")" class="text-success fw-bold text-decoration-none">Đăng nhập tại đây</a></small>
            </div>
        </div>
    </div>
</div>