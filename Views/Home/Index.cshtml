@model IEnumerable<QuanLyTapHoa.tblSanPham>

@{
    ViewBag.Title = "Trang chủ";
}

<div class="row g-4">

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-warning text-center">
                <i class="bi bi-box-seam"></i> Không có sản phẩm phù hợp
            </div>
        </div>
    }

    @foreach (var sp in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">

                <!-- ẢNH -->
                <img src="~/Content/Images/@(string.IsNullOrEmpty(sp.AnhSP) ? "noimage.png" : sp.AnhSP)"
                     class="card-img-top"
                     style="height: 180px; object-fit: cover;" />

                <div class="card-body d-flex flex-column">

                    <!-- TÊN -->
                    <h6 class="fw-bold text-truncate" title="@sp.TenSP">
                        @sp.TenSP
                    </h6>

                    <!-- GIÁ -->
                    <p class="text-danger fw-bold mb-1">
                        @String.Format("{0:N0} ₫", sp.GiaBan)
                    </p>

                    <!-- TỒN KHO -->
                    @if (sp.SoLuongTon > 0)
                    {
                        <span class="badge bg-success mb-2">
                            Còn hàng (@sp.SoLuongTon)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger mb-2">
                            Hết hàng
                        </span>
                    }

                    <!-- NÚT -->
                <div class="mt-auto">
                    @if (sp.SoLuongTon > 0)
                    {
                        <a href="@Url.Action("Them", "GioHang",new { iMaSP = sp.MaSP, strURL = Request.Url.ToString() })"class="btn btn-success w-100">
                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                        </a>

                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 mb-1" disabled>
                            Hết hàng
                        </button>
                    }

                    <a href="@Url.Action("Detail", "Home", new { id = sp.MaSP })"
                       class="btn btn-outline-success w-100">
                        <i class="bi bi-eye"></i> Xem chi tiết
                    </a>
                </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                </div>
            </div>
        </div>
    }

</div>
