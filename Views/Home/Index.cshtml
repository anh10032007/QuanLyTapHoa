@model List<QuanLyTapHoa.tblSanPham>
<h4 class="mb-3"> @( Session["User"]!=null?"Xin chào "+ ((tblKhachHang)Session["User"]).TenKH: "Sản phẩm nổi bật" )</h4>
<div class="row">
    @foreach (var item in Model)
    {
        <!-- Card 1 -->
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@Url.Content("~/Content/Images/"+item.AnhSP)" class="card-img-top" alt="@item.TenSP">
                <div class="card-body text-center d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="card-title text-truncate" title="@item.TenSP">@item.TenSP</h6>
                        <p class="text-danger fw-bold">@Html.FormatValue(item.GiaBan.Value, "{0:#,###}") VNĐ</p>
                    </div>

                    <div class="mt-2">
                        <a href="@Url.Action("Detail", "Home", new { id = item.MaSP })" class="btn btn-sm btn-light w-100 mb-2">
                            Xem chi tiết
                        </a>

                        <div class="d-flex justify-content-between" style="gap: 5px;">

                            <a href="@Url.Action("ThemGioHang", "GioHang", new { iMaSP = item.MaSP, strURL = Request.Url.ToString() })"
                               class="btn btn-sm btn-outline-success flex-fill" title="Thêm vào giỏ">
                                <i class="bi bi-cart-plus"></i> Thêm
                            </a>

                            <a href="@Url.Action("MuaNgay", "GioHang", new { iMaSP = item.MaSP })"
                               class="btn btn-sm btn-danger flex-fill text-white">
                                Mua ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>