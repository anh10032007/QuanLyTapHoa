@using QuanLyTapHoa
@model tblSanPham

@{
    ViewBag.Title = Model.TenSP;
    Layout = "~/Views/Shared/_Layout.cshtml"; 

    // Định dạng tiền tệ
    var priceFormat = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="row mt-4">
    <div class="col-md-5">
        <div class="product-gallery">
            <div class="main-image-container mb-3 text-center">
                <img id="mainImage"
                     src="@(string.IsNullOrEmpty(Model.AnhSP) ? "https://via.placeholder.com/400" : Url.Content("~/Content/Images/" + Model.AnhSP))"
                     alt="@Model.TenSP"
                     class="img-fluid border rounded shadow-sm"
                     style="max-height: 400px; object-fit: contain;">
            </div>

            
        </div>
    </div>

    <div class="col-md-7">
        <h2 class="fw-bold text-success">@Model.TenSP</h2>

        <h3 class="text-danger my-3">
            @String.Format(priceFormat, "{0:c0}", Model.GiaBan)
        </h3>

        <div class="card bg-light border-0 mb-4">
            <div class="card-body">
                <h5 class="card-title fw-bold"><i class="bi bi-info-circle"></i> Mô tả sản phẩm:</h5>
                <p class="card-text">
                    @Html.Raw(Model.MoTaChiTiet ?? "Đang cập nhật mô tả...")
                </p>
                <p><strong>Đơn vị tính:</strong> @(Model.DonViTinh ?? "Cái")</p>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Them", "GioHang", new { iMaSP = Model.MaSP, strURL = Request.Url.ToString() })"
               class="btn btn-success btn-lg px-4">
                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
            </a>
            <a href="@Url.Action("MuaNgay", "GioHang", new { iMaSP = Model.MaSP })"
               class="btn btn-danger btn-lg flex-grow-1 shadow-sm">
                <i class="bi bi-lightning-charge-fill"></i> Mua ngay
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-return-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>

<div class="mt-5">
    <h4 class="fw-bold border-bottom pb-2 mb-4 text-secondary">Sản phẩm cùng loại</h4>

    <div class="row">
        @if (ViewBag.SanphamLienQuan != null)
        {
            foreach (var item in (List<tblSanPham>)ViewBag.SanphamLienQuan)
            {
                <div class="col-md-3 col-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@(string.IsNullOrEmpty(item.AnhSP) ? "https://via.placeholder.com/200" : Url.Content("~/Content/Images/" + item.AnhSP))"
                             class="card-img-top p-3"
                             alt="@item.TenSP"
                             style="height: 200px; object-fit: contain;">

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate">
                                <a href="@Url.Action("Detail", "Home", new { id = item.MaSP })" class="text-decoration-none text-dark hover-green">
                                    @item.TenSP
                                </a>
                            </h6>
                            <p class="card-text text-danger fw-bold mt-auto">
                                @String.Format(priceFormat, "{0:c0}", item.GiaBan)
                            </p>
                            <a href="@Url.Action("Detail", "Home", new { id = item.MaSP })" class="btn btn-outline-success btn-sm mt-2">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Không có sản phẩm liên quan.</p>
        }
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".img-thumbnail").on("click", function () {
                var newImageSrc = $(this).data("full-src");
                $("#mainImage").attr("src", newImageSrc);
                $(".img-thumbnail").removeClass("border-success");
                $(this).addClass("border-success");
            });
        });
    </script>
}