@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center mt-5 mb-5" style="min-height: 400px;">
    <div class="py-5">
        <i class="bi bi-check-circle-fill text-success display-1"></i>
        <h2 class="fw-bold mt-4 text-success">ĐẶT HÀNG THÀNH CÔNG!</h2>
        <p class="lead text-secondary mt-3">
            Cảm ơn bạn đã mua sắm tại <strong>Tạp Hóa Tiện Lợi</strong>.<br>
            Đơn hàng của bạn đang được xử lý và sẽ sớm được giao đến.
        </p>

        <div class="mt-5">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-success btn-lg px-4 fw-bold">
                <i class="bi bi-house-door-fill"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>