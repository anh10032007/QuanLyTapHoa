@using QuanLyTapHoa.Models
@model Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Định dạng tiền tệ Việt Nam
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold text-success mb-4">
        <i class="bi bi-cart3"></i> Giỏ hàng của bạn
    </h2>

    @if (Model == null || Model.SoLuongMatHang() == 0)
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-basket display-1 text-muted"></i>
            <h4 class="mt-3 text-secondary">Giỏ hàng đang trống</h4>
            <p class="text-muted">Bạn chưa thêm sản phẩm nào vào giỏ hàng.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-success mt-3 px-4 py-2 fw-bold">
                <i class="bi bi-arrow-left"></i> Quay lại mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-9">
                <div class="table-responsive shadow-sm border rounded">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-success text-white">
                            <tr>
                                <th scope="col" class="py-3">Sản phẩm</th>
                                <th scope="col" class="py-3 text-center">Đơn giá</th>
                                <th scope="col" class="py-3 text-center" style="width: 150px;">Số lượng</th>
                                <th scope="col" class="py-3 text-center">Thành tiền</th>
                                <th scope="col" class="py-3 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.list)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@Url.Content("~/Content/Images/" + item.HinhAnh)"
                                                 alt="@item.TenSP"
                                                 class="img-thumbnail me-3"
                                                 style="width: 70px; height: 70px; object-fit: cover;">
                                            <div>
                                                <h6 class="mb-0 fw-bold">
                                                    <a href="@Url.Action("Detail", "Home", new { id = item.MaSP })" class="text-decoration-none text-dark">
                                                        @item.TenSP
                                                    </a>
                                                </h6>
                                                <small class="text-muted">Mã SP: @item.MaSP</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-center fw-bold text-secondary">
                                        @String.Format(culture, "{0:c0}", item.DonGia)
                                    </td>

                                    <td class="text-center">
                                        @using (Html.BeginForm("CapNhatGioHang", "GioHang", new { iMaSP = item.MaSP }))
                                        {
                                            <div class="input-group input-group-sm justify-content-center">
                                                <input type="number" name="txtSoLuong" value="@item.SoLuong" min="1"
                                                       class="form-control text-center border-success" style="max-width: 60px;">

                                                <button type="submit" class="btn btn-outline-success" title="Cập nhật">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </div>
                                        }
                                    </td>

                                    <td class="text-center fw-bold text-danger">
                                        @String.Format(culture, "{0:c0}", item.ThanhTien)
                                    </td>

                                    <td class="text-center">
                                        <a href="@Url.Action("XoaGioHang", "GioHang", new { iMaSP = item.MaSP })"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-3 mt-4 mt-lg-0">
                <div class="card shadow border-0 bg-light">
                    <div class="card-body">
                        <h5 class="card-title fw-bold border-bottom pb-2 mb-3">Tóm tắt đơn hàng</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng số lượng:</span>
                            <span class="fw-bold">@Model.TongSLHang()</span>
                        </div>

                        <div class="d-flex justify-content-between mb-4">
                            <span>Tạm tính:</span>
                            <span class="fw-bold text-danger fs-5">
                                @String.Format(culture, "{0:c0}", Model.TongThanhTien())
                            </span>
                        </div>

                        <div class="d-grid gap-2">
                            @if (Session["User"] == null)
                            {
                                <a href="@Url.Action("Login", "User")" class="btn btn-warning fw-bold">
                                    Đăng nhập để thanh toán
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("DatHang", "GioHang")" class="btn btn-success fw-bold py-2">
                                    <i class="bi bi-credit-card-2-front-fill"></i> TIẾN HÀNH ĐẶT HÀNG
                                </a>
                            }

                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary mt-2">
                                <i class="bi bi-arrow-left"></i> Tiếp tục mua hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>