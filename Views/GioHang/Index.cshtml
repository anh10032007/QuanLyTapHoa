@using QuanLyTapHoa.Models
@model Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formatTien = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container py-5">
    <h2 class="fw-bold text-success mb-4"><i class="bi bi-cart3"></i> Giỏ Hàng Của Bạn</h2>

    @if (Model == null || Model.SoLuongMatHang() == 0)
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-basket3 display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Giỏ hàng đang trống</h4>
            <p>Hãy dạo một vòng siêu thị và chọn những món đồ ưng ý nhé!</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-success rounded-pill px-4 mt-2">
                <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-success text-white">
                                    <tr>
                                        <th class="py-3 ps-4">Sản phẩm</th>
                                        <th class="py-3">Đơn giá</th>
                                        <th class="py-3 text-center">Số lượng</th>
                                        <th class="py-3 text-end">Thành tiền</th>
                                        <th class="py-3 text-center">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.list)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "https://via.placeholder.com/80" : Url.Content("~/Content/Images/" + item.HinhAnh))"
                                                         class="rounded border" style="width: 70px; height: 70px; object-fit: cover; margin-right: 15px;">
                                                    <div>
                                                        <h6 class="mb-0 fw-bold"><a href="@Url.Action("Detail", "Home", new { id = item.MaSP })" class="text-decoration-none text-dark">@item.TenSP</a></h6>
                                                        <small class="text-muted">Mã: #@item.MaSP</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-danger fw-bold">
                                                @String.Format(formatTien, "{0:c0}", item.DonGia)
                                            </td>
                                            <td class="text-center" style="width: 150px;">
                                                @using (Html.BeginForm("CapNhatGioHang", "GioHang", new { iMaSP = item.MaSP }))
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" name="txtSoLuong" value="@item.SoLuong" min="1" class="form-control text-center">
                                                        <button type="submit" class="btn btn-outline-secondary" title="Cập nhật">
                                                            <i class="bi bi-arrow-clockwise"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @String.Format(formatTien, "{0:c0}", item.ThanhTien)
                                            </td>
                                            <td class="text-center">
                                                <a href="@Url.Action("XoaGioHang", "GioHang", new { iMaSP = item.MaSP })"
                                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');"
                                                   class="btn btn-sm btn-outline-danger border-0">
                                                    <i class="bi bi-trash-fill fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">Cộng giỏ hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tổng số lượng:</span>
                            <span class="fw-bold">@Model.TongSLHang()</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fs-4 fw-bold text-danger">@String.Format(formatTien, "{0:c0}", Model.TongThanhTien())</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("DatHang", "GioHang")" class="btn btn-success btn-lg fw-bold shadow-sm">
                                TIẾN HÀNH ĐẶT HÀNG
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Mua thêm sản phẩm khác
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>