@using QuanLyTapHoa.Models
@model Cart

@{
    ViewBag.Title = "Xác nhận đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var kh = ViewBag.KhachHang as tblKhachHang;
    var formatTien = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container py-5">
    <h2 class="fw-bold text-success mb-4 text-center">XÁC NHẬN ĐƠN HÀNG</h2>

    @using (Html.BeginForm("DatHang", "GioHang", FormMethod.Post))
    {
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-success text-white py-3 rounded-top-4">
                        <h5 class="mb-0"><i class="bi bi-person-lines-fill"></i> Thông tin giao hàng</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Người nhận:</label>
                            <input type="text" class="form-control" value="@kh.TenKH" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại:</label>
                            <input type="text" class="form-control" value="@kh.SDT" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngày đặt hàng:</label>
                            <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ nhận hàng:</label>
                            <textarea class="form-control" name="DiaChiGiaoHang" rows="3" required>@kh.DiaChi</textarea>
                            <div class="form-text text-muted">Bạn có thể chỉnh sửa địa chỉ giao hàng tại đây.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-secondary text-white py-3 rounded-top-4">
                        <h5 class="mb-0"><i class="bi bi-receipt"></i> Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.list)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-success rounded-pill me-2">@item.SoLuong</span>
                                        <span class="fw-bold">@item.TenSP</span>
                                    </div>
                                    <span class="text-danger">@String.Format(formatTien, "{0:c0}", item.ThanhTien)</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-light py-3">
                                <span class="fw-bold fs-5">TỔNG CỘNG:</span>
                                <span class="fw-bold fs-4 text-danger">@String.Format(formatTien, "{0:c0}", Model.TongThanhTien())</span>
                            </li>
                        </ul>

                        <div class="p-4">
                            <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-5 shadow hover-scale">
                                <i class="bi bi-check2-circle"></i> XÁC NHẬN THANH TOÁN
                            </button>
                            <a href="@Url.Action("Index", "GioHang")" class="btn btn-link w-100 mt-2 text-decoration-none text-secondary">
                                Quay lại giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-scale:hover {
        transform: scale(1.02);
        transition: transform 0.2s;
    }
</style>