@using QuanLyTapHoa.Models
@model Cart

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy thông tin khách hàng từ ViewBag để hiển thị sẵn
    var kh = ViewBag.KhachHang as QuanLyTapHoa.tblKhachHang;
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold text-success mb-4 text-center">THANH TOÁN ĐƠN HÀNG</h2>

    @using (Html.BeginForm("DatHang", "GioHang", FormMethod.Post))
    {
        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-geo-alt-fill text-danger"></i> Thông tin giao hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Người nhận:</label>
                            <input type="text" class="form-control bg-light" value="@kh.TenKH" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại:</label>
                            <input type="text" class="form-control bg-light" value="@kh.SDT" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ nhận hàng (*):</label>
                            <input type="text" class="form-control border-success" name="DiaChiNhan"
                                   value="@kh.DiaChi" required placeholder="Nhập số nhà, tên đường...">
                            <div class="form-text">Bạn có thể sửa địa chỉ này nếu muốn giao nơi khác.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ghi chú đơn hàng:</label>
                            <textarea class="form-control" name="GhiChu" rows="3" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow border-0 bg-light">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-bag-check-fill"></i> Đơn hàng của bạn</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.list)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-secondary rounded-pill me-2">@item.SoLuong</span>
                                        <span class="text-truncate" style="max-width: 150px;">@item.TenSP</span>
                                    </div>
                                    <span class="fw-bold">@String.Format(culture, "{0:c0}", item.ThanhTien)</span>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between bg-white py-3">
                                <span class="fw-bold">Tạm tính:</span>
                                <span>@String.Format(culture, "{0:c0}", Model.TongThanhTien())</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between bg-white py-3">
                                <span class="fw-bold">Phí vận chuyển:</span>
                                <span class="text-success">Miễn phí</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between bg-warning bg-opacity-10 py-3">
                                <span class="fw-bold fs-5 text-danger">TỔNG CỘNG:</span>
                                <span class="fw-bold fs-5 text-danger">@String.Format(culture, "{0:c0}", Model.TongThanhTien())</span>
                            </li>
                        </ul>
                    </div>

                    <div class="card-footer bg-white p-3">
                        <div class="mb-3">
                            <label class="fw-bold mb-2">Phương thức thanh toán:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="cod" checked>
                                <label class="form-check-label" for="cod">
                                    <i class="bi bi-cash-stack text-success"></i> Thanh toán khi nhận hàng (COD)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="bank" disabled>
                                <label class="form-check-label text-muted" for="bank">
                                    <i class="bi bi-credit-card"></i> Chuyển khoản (Đang bảo trì)
                                </label>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow">
                                XÁC NHẬN ĐẶT HÀNG
                            </button>
                        </div>
                        <div class="text-center mt-2">
                            <a href="@Url.Action("Index", "GioHang")" class="text-decoration-none text-muted small">
                                <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>