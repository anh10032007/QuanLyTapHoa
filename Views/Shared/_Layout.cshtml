<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản Lý Tạp Hóa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar-header {
            color: #198754;
            border-bottom: 2px solid #198754;
            padding-bottom: 5px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow">
        <div class="container">
            <a class="navbar-brand fw-bold text-white" href="@Url.Action("Index", "Home")">
                <i class="bi bi-cart4"></i> Tạp Hóa Tiện Lợi
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    @if (Session["User"] == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login","User")"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register","User")"><i class="bi bi-person-plus"></i> Đăng ký</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle active" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                Xin chào, @Session["TenHienThi"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="#">Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" href="#">Đơn hàng của tôi</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","User")">Đăng xuất</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                @using (Html.BeginForm("TimKiem", "Home", FormMethod.Get, new { @class = "d-flex ms-lg-3" }))
                {
                    <input class="form-control me-2" name="keyword" type="search" placeholder="Tìm mắm, muối, mì..." aria-label="Search">
                    <button class="btn btn-outline-light" type="submit"><i class="bi bi-search"></i></button>
                }

                <a href="@Url.Action("Index", "GioHang")" class="btn btn-outline-light position-relative ms-3">
                    <i class="bi bi-cart3"></i>

                    @{
                        int soLuong = 0;
                        if (Session["GioHang"] != null)
                        {
                            // Ép kiểu về Cart model để lấy số lượng
                            var cart = Session["GioHang"] as QuanLyTapHoa.Models.Cart;
                            if (cart != null)
                            {
                                soLuong = cart.TongSLHang();
                            }
                        }
                    }

                    @if (soLuong > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @soLuong
                            <span class="visually-hidden">sản phẩm</span>
                        </span>
                    }
                </a>

            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <aside class="col-md-3 col-lg-2 mb-4">
                <h5 class="fw-bold sidebar-header"><i class="bi bi-list-ul"></i> Danh mục</h5>
                <div class="list-group mb-4">
                    @Html.Action("_DanhMuc", "Home")
                </div>

                <h5 class="fw-bold sidebar-header"><i class="bi bi-truck"></i> Nhà cung cấp</h5>
                <div class="list-group">
                    @Html.Action("_NhaCungCap", "Home")
                </div>
            </aside>

            <main class="col-md-9 col-lg-10">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill"></i> @ViewBag.Success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="bg-white p-3 rounded shadow-sm" style="min-height: 500px;">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="bg-dark text-light mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-success">Tạp Hóa Tiện Lợi</h5>
                    <p>
                        Chuyên cung cấp các mặt hàng thiết yếu, thực phẩm, gia dụng với giá cả bình ổn và chất lượng đảm bảo cho mọi gia đình.
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-success">Chăm sóc khách hàng</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none hover-green">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="text-light text-decoration-none hover-green">Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-light text-decoration-none hover-green">Vận chuyển & Giao nhận</a></li>
                    </ul>
                </div>

                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-success">Liên hệ</h5>
                    <p><i class="bi bi-geo-alt-fill"></i> 123 Đường Nguyễn Văn Linh, TP.HCM</p>
                    <p><i class="bi bi-telephone-fill"></i> 0909 123 456</p>
                    <p><i class="bi bi-envelope-fill"></i> cskh@taphoatienloi.com</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center">
                <small>&copy; 2025 QuanLyTapHoa App. All rights reserved.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>