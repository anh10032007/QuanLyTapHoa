@model IEnumerable<QuanLyTapHoa.Models.Account>
@{
    ViewBag.Title = "Quản Lý Tài Khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded">
        <div>
            <h2 class="text-success fw-bold mb-0"><i class="bi bi-people-fill"></i> QUẢN LÝ TÀI KHOẢN</h2>
            <small class="text-muted">Quản lý nhân viên và khách hàng trong hệ thống</small>
        </div>
        <a href="@Url.Action("CreateAccount", "Admin")" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Thêm tài khoản
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Tên đăng nhập</th>
                            <th>Họ tên / SĐT</th>
                            <th>Vai trò</th>
                            <th>Email / Địa chỉ</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@item.USERNAME</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.TenKH</div>
                                    <small class="text-muted"><i class="bi bi-phone"></i> @item.SDT</small>
                                </td>
                                <td>
                                    @if (item.VaiTro == "Admin")
                                    {
                                        <span class="badge rounded-pill bg-danger">Quản trị viên</span>
                                    }
                                    else if (item.VaiTro == "NhanVien")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark">Nhân viên</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-info text-dark">Khách hàng</span>
                                    }
                                </td>
                                <td>
                                    <div>@item.Email</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 150px;">
                                        @item.DiaChi
                                    </small>
                                </td>
                                <td>
                                    @if (item.TrangThai == 1)
                                    {
                                        <span class="text-success"><i class="bi bi-circle-fill me-1 small"></i> Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-circle-fill me-1 small"></i> Đang khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="@Url.Action("EditAccount", new { id = item.USERNAME })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@item.USERNAME')" title="Khóa/Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 15px 10px;
    }

    .badge {
        min-width: 100px;
    }

    .btn-group .btn {
        padding: 0.25rem 0.75rem;
    }
</style>

<script>
    function confirmDelete(username) {
        if (confirm('Bạn có chắc chắn muốn thực hiện thao tác với tài khoản ' + username + '?')) {
            window.location.href = '@Url.Action("DeleteAccount", "Admin")/' + username;
        }
    }
</script>