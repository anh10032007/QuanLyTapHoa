@model IEnumerable<QuanLyTapHoa.Models.DanhMuc>
@{
    ViewBag.Title = "Danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row">
    <!-- DANH SÁCH -->
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header">
                <h5>Danh sách danh mục</h5>
            </div>
            <table class="table table-bordered mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã</th>
                        <th>Tên danh mục</th>
                        <th>Số SP</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dm in Model)
                    {
                        <tr>
                            <td>@dm.MaDM</td>
                            <td>@dm.TenDM</td>
                            <td>
                                <span class="badge bg-info">
                                    @dm.SoSanPham
                                </span>
                            </td>
                            <td>
                                @if (dm.SoSanPham == 0)
                                {
                                    <a href="@Url.Action("DeleteCategory", new { id = dm.MaDM })"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Xóa danh mục này?')">
                                        Xóa
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" disabled>
                                        Không thể xóa
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- FORM THÊM -->
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header">
                <h5>Thêm danh mục</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    <div class="mb-3">
                        <label>Tên danh mục</label>
                        <input type="text" name="TenDM" class="form-control" required />
                    </div>

                    <button class="btn btn-success w-100">Thêm</button>
                }
            </div>
        </div>
    </div>
</div>
